# RISKCORE Backend Environment Variables
# Copy this file to .env and fill in the values
#
# IMPORTANT: RISKCORE is designed for ON-PREMISES deployment.
# All position, trade, and risk data stays on YOUR servers.
# No cloud storage - ever.

# ============================================
# DATABASE (Required - PostgreSQL)
# ============================================
# Your local/on-premises PostgreSQL server
# Format: postgresql://user:password@host:port/database

# Development (local PostgreSQL or Supabase local)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Production example (your internal server)
# DATABASE_URL=postgresql://riskcore_user:secure_password@db.internal.yourfirm.com:5432/riskcore

# ============================================
# APP SETTINGS
# ============================================
DEBUG=false
APP_NAME=RISKCORE
APP_VERSION=0.1.0

# Database connection pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================
# CORS (Configure for your internal network)
# ============================================
# CORS_ORIGINS=http://riskcore.internal.yourfirm.com,https://riskcore.internal.yourfirm.com

# ============================================
# OPTIONAL: OpenFIGI API Key
# ============================================
# For security identifier lookups (CUSIP/ISIN/SEDOL -> FIGI)
# Note: Only identifiers are sent to OpenFIGI, NOT position data
# OPENFIGI_API_KEY=your-openfigi-key
